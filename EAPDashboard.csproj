<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyName>EAPDashboard</AssemblyName>
    <RootNamespace>EAPDashboard</RootNamespace>
    <Authors>YH.CHIU</Authors>
    <Company>Cyntec</Company>
    <Product>EAP Dashboard</Product>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>EAP.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CyntecMqttLib\**;Protocol.Core\**;Protocol.Drivers.Secs\**;Protocol.Drivers.Mitsubishi\**;Protocol.Core_Backup\**;Protocol.MES\**;EQSimulator\**;MESSimulator\**;doc\**;EAPGateway\**;EAPController\**;EAPDashboard.Tests\**" />
    <Compile Remove="dll\**" />
    <EmbeddedResource Remove="CyntecMqttLib\**;Protocol.Core\**;Protocol.Drivers.Secs\**;Protocol.Drivers.Mitsubishi\**;Protocol.Core_Backup\**;Protocol.MES\**;EQSimulator\**;MESSimulator\**;doc\**;EAPGateway\**;EAPController\**;EAPDashboard.Tests\**" />
    <EmbeddedResource Remove="dll\**" />
    <None Remove="CyntecMqttLib\**;Protocol.Core\**;Protocol.Drivers.Secs\**;Protocol.Drivers.Mitsubishi\**;Protocol.Core_Backup\**;Protocol.MES\**;EQSimulator\**;MESSimulator\**;doc\**;EAPGateway\**;EAPController\**;EAPDashboard.Tests\**" />
    <None Remove="dll\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="EAP.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="3.0.16" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Polly" Version="7.2.4" />
    <PackageReference Include="Secs4Net" Version="2.4.4" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CyntecMqttLib\CyntecMqttLib.csproj" />
    <ProjectReference Include="Protocol.MES\Protocol.MES.csproj" />
    <Reference Include="Protocol.Core">
      <HintPath>dll\Protocol.Core.dll\Protocol.Core.dll</HintPath>
    </Reference>
    <Reference Include="Protocol.Drivers.Secs">
      <HintPath>dll\Protocol.Drivers.Secs.dll</HintPath>
    </Reference>
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\EquipmentCard.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\EquipmentCard.Designer.cs">
      <DependentUpon>EquipmentCard.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Dictionaries\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
