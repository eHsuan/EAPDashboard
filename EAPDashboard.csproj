<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyName>EAPDashboard</AssemblyName>
    <RootNamespace>EAPDashboard</RootNamespace>
    <Authors>YH.CHIU</Authors>
    <Company>Cyntec</Company>
    <Product>EAP Dashboard</Product>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>EAP.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CyntecMqttLib\**;Protocol.Core\**;Protocol.MES\**;EQSimulator\**;MESSimulator\**;doc\**" />
    <EmbeddedResource Remove="CyntecMqttLib\**;Protocol.Core\**;Protocol.MES\**;EQSimulator\**;MESSimulator\**;doc\**" />
    <None Remove="CyntecMqttLib\**;Protocol.Core\**;Protocol.MES\**;EQSimulator\**;MESSimulator\**;doc\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="EAP.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IoTClient" Version="1.0.42" />
    <PackageReference Include="log4net" Version="2.0.15" />
    <PackageReference Include="MQTTnet" Version="3.0.16" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NModbus4" Version="2.1.0" />
    <PackageReference Include="Secs4Net" Version="2.4.4" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CyntecMqttLib\CyntecMqttLib.csproj" />
    <ProjectReference Include="Protocol.Core\Protocol.Core.csproj" />
    <ProjectReference Include="Protocol.MES\Protocol.MES.csproj" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\EquipmentCard.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\EquipmentCard.Designer.cs">
      <DependentUpon>EquipmentCard.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Dictionaries\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
