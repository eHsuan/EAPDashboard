<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MESSimulator</RootNamespace>
    <AssemblyName>MESSimulator</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>MES.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="MES.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="3.0.16" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyntecMqttLib\CyntecMqttLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Protocol.Core">
      <HintPath>..\dll\Protocol.Core.dll\Protocol.Core.dll</HintPath>
    </Reference>
    <Reference Include="Protocol.Drivers.Secs">
      <HintPath>..\dll\Protocol.Drivers.Secs.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Dictionaries\*.json">
      <Link>Dictionaries\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Mapping\*.json">
      <Link>Mapping\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
