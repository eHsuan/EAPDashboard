<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RootNamespace>cyntec.Windows</RootNamespace>
    <AssemblyName>cyntec.WcfTxnReelCheck.Net8Test</AssemblyName>
    <ApplicationIcon>rocket.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="dll\cyntec.Base.dll" />
    <None Remove="dll\cyntec.Delta.dll" />
    <None Remove="dll\cyntec.Tools.dll" />
    <None Remove="dll\cyntec.wcfConnection.dll" />
    <None Remove="dll\cyntec.wcfInterface.dll" />
    <None Remove="dll\cyntec.wcfMessage.dll" />
    <None Remove="dll\cyntec.winBase.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- 微軟官方 WCF 8.x NuGet 套件 -->
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="rocket.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Reference Include="cyntec.MES">
      <HintPath>dll\cyntec.MES.dll</HintPath>
    </Reference>
    <Reference Include="cyntec.NET.Base">
      <HintPath>dll\cyntec.NET.Base.dll</HintPath>
    </Reference>
    <Reference Include="cyntec.NET.Delta">
      <HintPath>dll\cyntec.NET.Delta.dll</HintPath>
    </Reference>
    <Reference Include="cyntec.NET.Tools">
      <HintPath>dll\cyntec.NET.Tools.dll</HintPath>
    </Reference>
    <Reference Include="cyntec.NET.wcfConnection">
      <HintPath>dll\cyntec.NET.wcfConnection.dll</HintPath>
    </Reference>
    <Reference Include="cyntec.NET.wcfInterface">
      <HintPath>dll\cyntec.NET.wcfInterface.dll</HintPath>
    </Reference>
    <Reference Include="cyntec.NET.wcfMessage">
      <HintPath>dll\cyntec.NET.wcfMessage.dll</HintPath>
    </Reference>
    <Reference Include="cyntec.WinMESLite">
      <HintPath>dll\cyntec.WinMESLite.dll</HintPath>
    </Reference>
    <None Update="cyntec.ReelCheck.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
